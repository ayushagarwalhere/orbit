# Copy to .env.local. `npm run wallet` and `npm run deploy:anchor` fill the anchor settings for you.

# Chain for OrbitAnchor: base-sepolia | sepolia | polygon-amoy | localhost
ORBIT_CHAIN=base-sepolia
# Deployed OrbitAnchor contract
ORBIT_ANCHOR_ADDRESS=
# EVM key that publishes anchors (testnet only; keep secret)
ORBIT_ANCHOR_PRIVATE_KEY=
# Optional: your own RPC URL instead of the public one
ORBIT_RPC_URL=
# Optional: actor keystore JSON (output of `npm run keystore`) for hosted deployments
ORBIT_KEYSTORE=
# Demo controls (role-play keys, reset, tamper). Set to 0 to disable.
ORBIT_DEMO_MODE=1
# Set to 0 to disable automatic anchoring after writes
ORBIT_AUTO_ANCHOR=1
